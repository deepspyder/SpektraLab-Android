<resources>
    <style name="Base.Theme.Theia" parent="android:Theme.Material.NoActionBar">
        <item name="android:fontFamily">@font/theia_rounded</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/theia_background</item>
        <item name="android:navigationBarColor">@color/theia_background</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/theia_background</item>
        <item name="android:colorAccent">@color/theia_primary</item>
    </style>

    <style name="Theme.Theia" parent="Base.Theme.Theia" />

    <style name="Base.Theme.Theia.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/theia_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_theia_mark</item>
        <item name="windowSplashScreenAnimationDuration">520</item>
        <item name="postSplashScreenTheme">@style/Theme.Theia</item>
        <item name="android:statusBarColor">@color/theia_background</item>
        <item name="android:navigationBarColor">@color/theia_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="Theme.Theia.Starting" parent="Base.Theme.Theia.Starting" />
</resources>
