# F14 owns only the Android extension. Never edit either desktop checkout.
# Source-only staging keeps all translation units on the same Params/Profile ABI.
macro(theia_f14_replace variable before after label)
    string(FIND "${${variable}}" "${before}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "Theia F14: shared source changed at ${label}")
    endif()
    string(LENGTH "${before}" length)
    math(EXPR remainder_start "${position} + ${length}")
    string(SUBSTRING "${${variable}}" ${remainder_start} -1 remainder)
    string(FIND "${remainder}" "${before}" duplicate)
    if(NOT duplicate EQUAL -1)
        message(FATAL_ERROR "Theia F14: ambiguous ${label} anchor")
    endif()
    string(REPLACE "${before}" "${after}" ${variable} "${${variable}}")
endmacro()

function(theia_f14_write path value)
    set(previous "")
    if(EXISTS "${path}")
        file(READ "${path}" previous)
    endif()
    if(NOT value STREQUAL previous)
        file(WRITE "${path}" "${value}")
    endif()
endfunction()

function(theia_android_halation engine_dir output_variable)
    set(overlay "${CMAKE_CURRENT_BINARY_DIR}/generated/f14-engine")
    file(GLOB_RECURSE inputs CONFIGURE_DEPENDS LIST_DIRECTORIES false "${engine_dir}/src/*")
    foreach(input IN LISTS inputs)
        file(RELATIVE_PATH relative "${engine_dir}" "${input}")
        if(relative MATCHES "^src/core/(params|profile)\\.(cpp|hpp)$" OR
           relative MATCHES "^src/pipeline/(engine\\.cpp|pipeline\\.(cpp|hpp))$" OR
           relative STREQUAL "src/gpu/vulkan_gpu.cpp")
            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${input}")
        else()
            configure_file("${input}" "${overlay}/${relative}" COPYONLY)
        endif()
    endforeach()
    set(owned "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../halation")
    configure_file("${owned}/halation_psf.hpp" "${overlay}/src/core/halation_psf.hpp" COPYONLY)
    configure_file("${owned}/../shaders/vulkan/spk_highlight_headroom.comp"
        "${overlay}/src/shaders/vulkan/spk_highlight_headroom.comp" COPYONLY)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${owned}/ProfileAlias.cpp.in" "${owned}/Headroom.cpp.in" "${owned}/BackReflection.cpp.in")

    file(READ "${engine_dir}/src/core/params.hpp" source)
    set(before "    bool halation_renormalize = true;\n};")
    set(after "    bool halation_renormalize = true;\n    // Version 1 preserves every previously saved Android look.\n    int model_version = 1;\n    bool back_reflection = false;\n    double base_thickness_um = 120.0;\n    double headroom_ev = 4.0;\n    double headroom_from_ev = 1.5;\n    double headroom_to_ev = 2.5;\n};")
    theia_f14_replace(source "${before}" "${after}" "HalationParams")
    theia_f14_write("${overlay}/src/core/params.hpp" "${source}")

    file(READ "${engine_dir}/src/core/profile.hpp" source)
    set(before "    std::string use = \"still\", antihalation = \"weak\", target_print;")
    theia_f14_replace(source "${before}" "${before}\n    std::string base_stock;" "profile alias identity")
    theia_f14_write("${overlay}/src/core/profile.hpp" "${source}")
    file(READ "${engine_dir}/src/core/profile.cpp" source)
    set(signature "bool load_profile(const std::string& resources_dir, const std::string& stock,")
    string(FIND "${source}" "${signature}" start)
    if(start EQUAL -1)
        message(FATAL_ERROR "Theia F14: profile loader boundary changed")
    endif()
    string(SUBSTRING "${source}" 0 ${start} prefix)
    file(READ "${owned}/ProfileAlias.cpp.in" alias)
    theia_f14_write("${overlay}/src/core/profile.cpp" "${prefix}${alias}\n\n}  // namespace spk\n")

    file(READ "${engine_dir}/src/core/params.cpp" source)
    theia_f14_replace(source "#include \"params.hpp\"" "#include \"params.hpp\"\n#include \"halation_psf.hpp\"" "preset include")
    set(before "    {\"camera_filter\",            \"camera.filter\",                         S, SHOOT, false, 0, 0, false},")
    set(after "${before}\n    {\"halation_model_version\", \"film_render.halation.model_version\", I, SHOOT, true, 1.0, 2.0, false},\n    {\"halation_headroom_ev\", \"film_render.halation.headroom_ev\", F, SHOOT, true, 0.0, 8.0, false},")
    theia_f14_replace(source "${before}" "${after}" "wire fields")
    set(before "        if (f->has_range) {")
    set(after "        if (kv.first == \"halation_model_version\" && v.as_double() != 1.0 && v.as_double() != 2.0) {\n            error = \"halation_model_version must be 1 or 2\";\n            param = kv.first;\n            return false;\n        }\n${before}")
    theia_f14_replace(source "${before}" "${after}" "model version validation")
    set(before "int* int_slot(Params& p, const std::string& path) {")
    theia_f14_replace(source "${before}" "${before}\n    if (path == \"film_render.halation.model_version\") return &p.film_render.halation.model_version;" "model wire slot")
    set(before "    if (path == \"film_render.halation.halation_amount\") return &p.film_render.halation.halation_amount;")
    theia_f14_replace(source "${before}" "${before}\n    if (path == \"film_render.halation.headroom_ev\") return &p.film_render.halation.headroom_ev;" "headroom wire slot")
    set(before "    const std::string& use = p.film.info.use;")
    theia_f14_replace(source "${before}" "    p.film_render.halation.back_reflection = false;\n${before}" "reset physical preset")
    set(before "    else if (ah == \"no\") { s0 = 0.30; s1 = 0.10; s2 = 0.015; }")
    set(after "    else if (ah == \"no\" && p.film_render.halation.model_version == 2) {\n        s0 = kBackReflectionStrength[0]; s1 = kBackReflectionStrength[1]; s2 = kBackReflectionStrength[2];\n    }\n${before}")
    theia_f14_replace(source "${before}" "${after}" "layer return strengths")
    set(before "    set3(p.film_render.halation.halation_strength, s0, s1, s2);")
    theia_f14_replace(source "${before}" "${before}\n    p.film_render.halation.back_reflection = p.film_render.halation.model_version == 2 && ah == \"no\";" "select physical preset")
    set(before "        const Json& row = neutral_filters.at(p.print.info.stock)\n                                          .at(p.enlarger.illuminant)\n                                          .at(p.film.info.stock);")
    set(after "        const Json& by_film = neutral_filters.at(p.print.info.stock).at(p.enlarger.illuminant);\n        const Json& own = by_film.at(p.film.info.stock);\n        const Json& row = own.is_array() || p.film.info.base_stock.empty()\n                              ? own : by_film.at(p.film.info.base_stock);")
    theia_f14_replace(source "${before}" "${after}" "alias neutral pack")
    theia_f14_write("${overlay}/src/core/params.cpp" "${source}")

    file(READ "${engine_dir}/src/pipeline/engine.cpp" source)
    set(before "if (delta.has(\"antihalation_removed\")) apply_halation_preset(session->params);")
    theia_f14_replace(source "${before}" "if (delta.has(\"antihalation_removed\") || delta.has(\"halation_model_version\")) apply_halation_preset(session->params);" "model edit invalidation")
    theia_f14_write("${overlay}/src/pipeline/engine.cpp" "${source}")

    file(READ "${engine_dir}/src/pipeline/pipeline.hpp" source)
    set(before "    bool node_boost(const Image& in, Image& out, std::string& error);")
    theia_f14_replace(source "${before}" "${before}\n    bool headroom_wanted() const;\n    bool node_headroom(const Image& in, Image& out, std::string& error);" "headroom declarations")
    theia_f14_write("${overlay}/src/pipeline/pipeline.hpp" "${source}")
    file(READ "${engine_dir}/src/pipeline/pipeline.cpp" source)
    theia_f14_replace(source "#include \"pipeline.hpp\"" "#include \"pipeline.hpp\"\n#include \"core/halation_psf.hpp\"" "PSF include")
    file(READ "${owned}/Headroom.cpp.in" headroom)
    set(before "double Pipeline::lens_blur_sigma() const {")
    theia_f14_replace(source "${before}" "${headroom}\n\n${before}" "headroom node")
    file(READ "${owned}/BackReflection.cpp.in" back_reflection)
    set(before "    if (N >= 1 && any_strength && any_sigma) {\n")
    theia_f14_replace(source "${before}" "${back_reflection}" "PSF mixture")
    set(before "    SPK_NODE(node_boost(cur, next, error)); cur = next;")
    theia_f14_replace(source "${before}" "${before}\n    if (headroom_wanted()) { SPK_NODE(node_headroom(cur, next, error)); cur = next; }" "whole-frame headroom stage")
    theia_f14_write("${overlay}/src/pipeline/pipeline.cpp" "${source}")

    file(READ "${engine_dir}/src/gpu/vulkan_gpu.cpp" source)
    set(before "    {\"spk_boost\", 4, kWorkgroup},")
    theia_f14_replace(source "${before}" "${before}\n    {\"spk_highlight_headroom\", 4, kWorkgroup}," "Vulkan headroom binding")
    theia_f14_write("${overlay}/src/gpu/vulkan_gpu.cpp" "${source}")
    set(${output_variable} "${overlay}" PARENT_SCOPE)
endfunction()
