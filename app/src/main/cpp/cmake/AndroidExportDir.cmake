# Reuse the upstream DIR body verbatim, changing only counted-image lifetimes.
function(theia_android_export_dir pipeline_source output_variable)
    set(signature "bool Pipeline::node_dir_couplers(const Image& cmy, const Image& log_raw, Image& out,\n                                 std::string& error) {\n")
    set(tail "\n}\n\n// RFC-025's strength")
    string(FIND "${pipeline_source}" "${signature}" start)
    string(FIND "${pipeline_source}" "${tail}" finish)
    if(start EQUAL -1 OR finish EQUAL -1 OR finish LESS start)
        message(FATAL_ERROR "Theia DIR adapter: upstream node boundaries changed; review its readers")
    endif()
    string(LENGTH "${signature}" signature_length)
    math(EXPR body_start "${start} + ${signature_length}")
    math(EXPR body_length "${finish} - ${body_start}")
    string(SUBSTRING "${pipeline_source}" ${body_start} ${body_length} THEIA_DIR_BODY)

    set(before_correction "                        cmy.pixels(), error)) return false;")
    set(after_correction "${before_correction}\n    if (!gpu_->flush(error)) return false;\n    cmy = Image{};\n    theia::export_execution::trace_memory(gpu_, \"dir_after_correction\");")
    set(before_diffusion "    double a[3], b[3];")
    set(after_diffusion "    theia::export_execution::trace_memory(gpu_, \"dir_after_diffusion\");\n${before_diffusion}")
    set(before_combine "    if (!blur_.lincomb(log_raw, corr, a, b, log_raw_0, error)) return false;")
    set(after_combine "${before_combine}\n    if (!gpu_->flush(error)) return false;\n    corr = Image{};\n    log_raw = Image{};\n    theia::export_execution::trace_memory(gpu_, \"dir_after_combine\");")
    foreach(anchor correction diffusion combine)
        string(FIND "${THEIA_DIR_BODY}" "${before_${anchor}}" found)
        if(found EQUAL -1)
            message(FATAL_ERROR "Theia DIR adapter: upstream ${anchor} changed; review exact operations")
        endif()
        string(LENGTH "${before_${anchor}}" anchor_length)
        math(EXPR after_anchor "${found} + ${anchor_length}")
        string(SUBSTRING "${THEIA_DIR_BODY}" ${after_anchor} -1 remainder)
        string(FIND "${remainder}" "${before_${anchor}}" duplicate)
        if(NOT duplicate EQUAL -1)
            message(FATAL_ERROR "Theia DIR adapter: ambiguous ${anchor} anchor")
        endif()
        string(REPLACE "${before_${anchor}}" "${after_${anchor}}" THEIA_DIR_BODY "${THEIA_DIR_BODY}")
    endforeach()

    set(template "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/templates/ExportFilmSegment.cpp.in")
    include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/AndroidExportHalation.cmake")
    theia_android_export_halation("${pipeline_source}" THEIA_HALATION_BODY)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${template}")
    file(READ "${template}" segment)
    string(CONFIGURE "${segment}" segment @ONLY)
    set(${output_variable} "${segment}" PARENT_SCOPE)
endfunction()
