# Reuse only mixture-owned accumulators in pointwise final writes. IIR's
# recurrence needs the old accumulator during both sweeps and stays unchanged.
function(theia_android_export_mixture input_source output_variable)
    set(source "${input_source}")
    set(before_include "#include \"export_fir_bands.hpp\"")
    set(after_include "${before_include}\n#include \"export_mixture_accumulator.hpp\"")
    set(before_fir "    Image tmp;\n    if (!alloc_like(img, tmp, error)) return false;\n    if (!alloc_like(img, out, error)) return false;")
    set(after_fir "    Image tmp;\n    if (!alloc_like(img, tmp, error)) return false;\n    if (theia::export_execution::MixtureAccumulatorScope::can_reuse(acc, img)) {\n        out = *acc;\n        ++theia::export_execution::mixture_reuses.fir;\n    } else if (!alloc_like(img, out, error)) return false;")
    set(before_zero "                if (!gaussian(img, comp.sigma, acc, error, truncate, &zero, comp.weight)) return false;")
    set(after_zero "                theia::export_execution::MixtureAccumulatorScope ownership(zero);\n${before_zero}")
    set(before_next "            if (!gaussian(img, comp.sigma, next, error, truncate, &acc, comp.weight)) return false;")
    set(after_next "            theia::export_execution::MixtureAccumulatorScope ownership(acc);\n${before_next}")
    set(lincomb_tail "\n    const uint32_t n[1] = {uint32_t(x.elements())};\n    return gpu_->dispatch(\"spk_lincomb3\",")
    set(before_lincomb "    if (!alloc_like(x, out, error)) return false;${lincomb_tail}")
    set(after_lincomb "    if (theia::export_execution::MixtureAccumulatorScope::can_reuse(&x, y)) {\n        out = x;\n        ++theia::export_execution::mixture_reuses.lincomb;\n    } else if (!alloc_like(x, out, error)) return false;${lincomb_tail}")
    set(before_cancel "        if (!gpu_->flush(error)) return false;\n    }\n    if (!have_acc)")
    set(after_cancel "        if (!gpu_->flush(error)) return false;\n        if (theia::export_execution::one_shot && theia::export_execution::cancellation &&\n            theia::export_execution::cancellation->load(std::memory_order_relaxed)) {\n            error = \"render cancelled\";\n            return false;\n        }\n    }\n    if (!have_acc)")
    foreach(anchor include fir zero next lincomb cancel)
        string(FIND "${source}" "${before_${anchor}}" found)
        if(found EQUAL -1)
            message(FATAL_ERROR "Theia mixture adapter: upstream ${anchor} changed; review read/write ownership")
        endif()
        string(LENGTH "${before_${anchor}}" anchor_length)
        math(EXPR after_anchor "${found} + ${anchor_length}")
        string(SUBSTRING "${source}" ${after_anchor} -1 remainder)
        string(FIND "${remainder}" "${before_${anchor}}" duplicate)
        if(NOT duplicate EQUAL -1)
            message(FATAL_ERROR "Theia mixture adapter: ambiguous ${anchor} anchor")
        endif()
        string(REPLACE "${before_${anchor}}" "${after_${anchor}}" source "${source}")
    endforeach()
    set(${output_variable} "${source}" PARENT_SCOPE)
endfunction()
