# Build an Android adapter from the unchanged shared FIR implementation.
function(theia_android_export_fir engine_dir output_variable)
    set(upstream "${engine_dir}/src/pipeline/blur.cpp")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${upstream}")
    file(READ "${upstream}" source)
    set(before_include "#include \"blur.hpp\"")
    set(after_include "#include \"blur.hpp\"\n#include \"export_fir_bands.hpp\"")
    set(before_fir "    if (R == 0 && active[0] && active[1] && active[2] && !acc) { out = img; return true; }")
    set(after_fir "${before_fir}\n    if (theia::export_execution::use_fir_bands(img, R)) {\n        return theia::export_execution::run_fir_bands(gpu_, img, acc, R,\n            theia::export_execution::fir_output_rows(img), out, error,\n            [&](const Image& band, const Image* band_acc, Image& result) {\n                return fir(band, sigmas, truncate, active, result, error, band_acc, weight);\n            });\n    }")
    foreach(anchor include fir)
        string(FIND "${source}" "${before_${anchor}}" found)
        if(found EQUAL -1)
            message(FATAL_ERROR "Theia FIR adapter: shared source changed at ${anchor}; review exact band boundaries")
        endif()
        string(LENGTH "${before_${anchor}}" anchor_length)
        math(EXPR after_anchor "${found} + ${anchor_length}")
        string(SUBSTRING "${source}" ${after_anchor} -1 remainder)
        string(FIND "${remainder}" "${before_${anchor}}" duplicate)
        if(NOT duplicate EQUAL -1)
            message(FATAL_ERROR "Theia FIR adapter: ambiguous ${anchor} anchor")
        endif()
        string(REPLACE "${before_${anchor}}" "${after_${anchor}}" source "${source}")
    endforeach()
    include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/AndroidExportMixture.cmake")
    theia_android_export_mixture("${source}" source)
    set(generated "${CMAKE_CURRENT_BINARY_DIR}/generated/blur_android.cpp")
    file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/generated")
    set(previous "")
    if(EXISTS "${generated}")
        file(READ "${generated}" previous)
    endif()
    if(NOT source STREQUAL previous)
        file(WRITE "${generated}" "${source}")
    endif()
    set(${output_variable} "${generated}" PARENT_SCOPE)
endfunction()
