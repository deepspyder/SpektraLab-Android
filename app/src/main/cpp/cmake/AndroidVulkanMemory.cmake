# Keep the mobile allocation policy in this repository. Compile a generated
# adapter of the shared backend; never modify the desktop engine checkout.
function(theia_android_vulkan_backend engine_dir output_variable)
    set(upstream "${engine_dir}/src/gpu/vulkan_gpu.cpp")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${upstream}")
    file(READ "${upstream}" source)

    set(before_include "#include \"gpu.hpp\"")
    set(after_include "#include \"gpu.hpp\"\n#include \"vulkan_memory_policy.hpp\"")
    set(before_reuse "!b->persistent && b->refs == 0 && b->bytes >= bytes &&")
    set(after_reuse "!b->persistent && b->refs == 0 && theia::vulkan_memory::can_reuse(b->bytes, bytes) &&")
    set(before_claim "best->refs = 1;")
    set(after_claim "best->refs = 1;\n                theia::vulkan_memory::trim_idle(buffers_, [this](Buffer* idle) { destroy_buffer(idle); });")
    set(before_create "auto b = std::make_unique<Buffer>();")
    set(after_create "theia::vulkan_memory::trim_idle(buffers_, [this](Buffer* idle) { destroy_buffer(idle); });\n        auto b = std::make_unique<Buffer>();")

    foreach(anchor include reuse claim create)
        string(FIND "${source}" "${before_${anchor}}" found)
        if(found EQUAL -1)
            message(FATAL_ERROR "Theia Vulkan adapter: shared backend changed at ${anchor}; review the allocation policy before building")
        endif()
        string(LENGTH "${before_${anchor}}" anchor_length)
        math(EXPR after_anchor "${found} + ${anchor_length}")
        string(SUBSTRING "${source}" ${after_anchor} -1 remaining_source)
        string(FIND "${remaining_source}" "${before_${anchor}}" duplicate)
        if(NOT duplicate EQUAL -1)
            message(FATAL_ERROR "Theia Vulkan adapter: ambiguous ${anchor} anchor in shared backend")
        endif()
        string(REPLACE "${before_${anchor}}" "${after_${anchor}}" source "${source}")
    endforeach()

    set(generated "${CMAKE_CURRENT_BINARY_DIR}/generated/vulkan_gpu_android.cpp")
    file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/generated")
    set(previous_source "")
    if(EXISTS "${generated}")
        file(READ "${generated}" previous_source)
    endif()
    if(NOT source STREQUAL previous_source)
        file(WRITE "${generated}" "${source}")
    endif()
    set(${output_variable} "${generated}" PARENT_SCOPE)
endfunction()
