# Extract the original node, replacing only the input's counted ownership.
function(theia_android_export_halation pipeline_source output_variable)
    set(signature "bool Pipeline::node_halation(const Image& in, Image& out, std::string& error) {\n")
    set(tail "\n}\n\nbool Pipeline::node_expose_log")
    string(FIND "${pipeline_source}" "${signature}" start)
    string(FIND "${pipeline_source}" "${tail}" finish)
    if(start EQUAL -1 OR finish EQUAL -1 OR finish LESS start)
        message(FATAL_ERROR "Theia halation adapter: node boundaries changed; review the input's last reader")
    endif()
    string(LENGTH "${signature}" signature_length)
    math(EXPR body_start "${start} + ${signature_length}")
    math(EXPR body_length "${finish} - ${body_start}")
    string(SUBSTRING "${pipeline_source}" ${body_start} ${body_length} body)
    set(before "    Image raw = in;")
    string(FIND "${body}" "${before}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "Theia halation adapter: input owner changed")
    endif()
    string(REPLACE "${before}" "    Image raw = std::move(in);" body "${body}")
    set(${output_variable} "${body}" PARENT_SCOPE)
endfunction()
