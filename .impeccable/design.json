      "html": "<button class=\"ds-primary\">应用</button>",
      "css": ".ds-primary{min-height:48px;padding:0 24px;border:0;border-radius:6px;background:#E5AA55;color:#261A0C;font:500 14px sans-serif}.ds-primary:hover{filter:brightness(1.08)}.ds-primary:focus-visible{outline:2px solid #F2EEE6;outline-offset:2px}.ds-primary:active{filter:brightness(.9)}"
