  "components": [
    {
      "name": "观景台自由画布",
      "kind": "custom",
      "description": "原比例无边框照片自由摆放；拖动照片移动单张，空白处平移，双指缩放画布35–600%。接近相邻边缘时按18dp屏幕距离、至少30%公共边和最近锚点自动对齐；超过较小照片26%面积的深度重叠保持自由叠放。240ms FastOutSlowIn平移并淡出接缝提示，重叠区域120ms将上层透明度降至0.58，未覆盖区域保持原alpha；可单独拉开，不形成群组或拼接导出。位置与叠放顺序保存，按需串行加载可见高清预览，最多请求4张、缓存6张；已显影效果优先。显示原始尺寸与格式，原文件不改写。灯光360ms过渡，窗口亮度0.9/0.2并在退出后恢复；动画遵守系统缩放。",
      "html": "<section class=\"ds-photo-table\"><header>观景台</header><div class=\"ds-photo-space\"><div class=\"ds-photo a\">横向照片</div><div class=\"ds-photo b\">竖向照片</div><div class=\"ds-photo c\">全景照片</div></div><footer>拖动照片 · 双指缩放　 −　100%　＋</footer></section>",
      "css": ".ds-photo-table{background:#F1EEE7;color:#242321;font:14px sans-serif;padding:16px}.ds-photo-table header{font-size:20px}.ds-photo-space{position:relative;min-height:280px;margin-top:20px}.ds-photo{position:absolute;display:grid;place-items:center;background:#39372F;color:#F1EEE7;font-size:11px;cursor:grab}.ds-photo.a{left:0;top:8px;width:140px;height:95px}.ds-photo.b{left:165px;top:35px;width:100px;height:160px}.ds-photo.c{left:10px;top:215px;width:220px;height:48px}.ds-photo-table footer{min-height:48px;display:flex;align-items:center;font-size:12px}"
    },
    {
      "name": "主要操作",
      "kind": "button",
      "refersTo": "action-primary",
      "description": "主要操作，最小高度 48dp。",
      "html": "<button class=\"ds-primary\">应用</button>",
      "css": ".ds-primary{min-height:48px;padding:0 24px;border:0;border-radius:12px;background:#E5AA55;color:#261A0C;font:500 14px sans-serif}.ds-primary:hover{filter:brightness(1.08)}.ds-primary:focus-visible{outline:2px solid #F2EEE6;outline-offset:2px}.ds-primary:active{filter:brightness(.9)}"
    },
    {
      "name": "次要操作",
      "kind": "button",
      "description": "描边操作。",
      "html": "<button class=\"ds-outline\">取消</button>",
      "css": ".ds-outline{min-height:48px;padding:0 24px;border:1px solid #888888;border-radius:12px;background:transparent;color:#E5AA55;font:500 14px sans-serif}.ds-outline:hover{background:#252525}.ds-outline:focus-visible{outline:2px solid #E5AA55;outline-offset:2px}.ds-outline:active{background:#2E2E2E}"
    },
    {
      "name": "分段选择",
      "kind": "chip",
      "refersTo": "choice-selected",
      "description": "低表面上的选项，选中项使用高表面并公开 selected 语义。",
      "html": "<div class=\"ds-strip\"><button class=\"ds-choice ds-selected\">正片</button><button class=\"ds-choice\">负片</button></div>",
      "css": ".ds-strip{display:flex;background:#191919;border-radius:12px}.ds-choice{min-height:48px;padding:0 18px;border:0;border-radius:12px;background:transparent;color:#B8B2A8}.ds-selected{background:#2E2E2E;color:#E5AA55}.ds-choice:hover{background:#252525}.ds-choice:focus-visible{outline:2px solid #E5AA55;outline-offset:-2px}"
    },
    {
      "name": "暗房分段选择",
      "kind": "chip",
      "description": "导航底色外框；按钮最小 48dp，内部选中背景最小 40dp、外留 4dp 内边距。处理禁用时保留选中背景。",
      "html": "<div class=\"ds-darkroom-strip\"><button class=\"ds-darkroom-option\" aria-pressed=\"true\"><span class=\"ds-darkroom-active\">单张导出</span></button><button class=\"ds-darkroom-option\" aria-pressed=\"false\"><span>批量导出</span></button></div>",
      "css": ".ds-darkroom-strip{display:flex;background:#222222;border-radius:12px}.ds-darkroom-option{flex:1;min-height:48px;padding:4px;border:0;background:transparent;color:#B8B2A8;font:12px sans-serif}.ds-darkroom-option span{display:grid;place-items:center;min-height:40px;border-radius:8px}.ds-darkroom-active{background:#2E2E2E;color:#E5AA55;font-weight:600}.ds-darkroom-option:hover span{filter:brightness(1.1)}.ds-darkroom-option:focus-visible{outline:2px solid #E5AA55;outline-offset:-2px}"
    },
    {
      "name": "选项选择行",
      "kind": "input",
      "description": "外层至少 64dp；按钮动作是展开选项，标签与当前值分别提供 contentDescription 和 stateDescription。OptionsDropdown 的菜单项公开 selected 语义。optionLabel 为测光、镜头滤镜、片边和日期枚举显示中文，wire 值与序列化不变。",
      "html": "<button class=\"ds-selection\" aria-label=\"测光方法\" aria-description=\"均衡\"><span><small>测光方法</small><br>均衡</span><span aria-hidden=\"true\">⌄</span></button>",
      "css": ".ds-selection{display:flex;align-items:center;justify-content:space-between;width:100%;min-height:64px;padding:4px 2px;border:0;border-bottom:1px solid #424242;background:transparent;color:#F2EEE6;text-align:left;font:14px sans-serif}.ds-selection small{color:#B8B2A8;font-size:12px}.ds-selection:hover{background:#252525}.ds-selection:focus-visible{outline:2px solid #E5AA55;outline-offset:-2px}.ds-selection:active{background:#2E2E2E}"
    },
    {
      "name": "胶片与相纸滤镜选择",
      "kind": "card",
      "refersTo": "film-filter-selected",
      "description": "上方Fit实时照片预览，底部横向胶片/相纸选择条。选项宽76dp×fontScale（上限1.25），方形纸面标签高88dp，只有选中项有10dp圆角底色和1dp琥珀边框。分类为轻量文字；完整所选型号显示在条下。右上完成，预览提供原片对比。标签依P1/P2参考重制，带轻微纸边和投影，无胶卷筒造型。横屏>=700dp时为340dp侧面板。 素材正面、纸边和投影共用柔和圆角。",
      "html": "<section class=\"ds-filters\"><div class=\"ds-live-photo\">照片实时预览</div><div class=\"ds-filter-tabs\">胶片库　相纸</div><div class=\"ds-filter-categories\">全部　彩色负片　正片　黑白</div><div class=\"ds-filter-strip\"><button aria-pressed=\"true\"><img alt=\"Portra 400\"><span>Portra 400</span></button><button><img alt=\"Gold 200\"><span>Gold 200</span></button></div></section>",
      "css": ".ds-filters{background:#151515;color:#F2EEE6;font:12px sans-serif}.ds-live-photo{height:360px}.ds-filter-tabs,.ds-filter-categories{min-height:48px;background:#191919}.ds-filter-strip{display:flex;gap:8px;overflow:auto;padding:4px 16px;background:#191919}.ds-filter-strip button{flex:none;width:76px;background:transparent;border:0;color:#B8B2A8}.ds-filter-strip img{height:88px;width:76px}.ds-filter-strip [aria-pressed=true] img{border:1px solid #E5AA55;border-radius:10px;background:#2E2E2E}"
    },
    {
      "name": "底部导航",
      "kind": "nav",
      "description": "紧凑底栏基准 64dp，字体放大时增高；19dp 图标、48×28dp 选中背景、11sp 标签，选项公开 Tab 和 selected 语义。",
      "html": "<nav class=\"ds-nav\" aria-label=\"编辑导航\"><button class=\"ds-nav-item ds-current\" aria-current=\"page\"><span class=\"ds-nav-icon\">◇</span>拍摄</button><button class=\"ds-nav-item\"><span class=\"ds-nav-icon\">□</span>放印</button><button class=\"ds-nav-item\"><span class=\"ds-nav-icon\">○</span>调色</button></nav>",
      "css": ".ds-nav{display:flex;min-height:64px;background:#222222}.ds-nav-item{display:flex;flex:1;flex-direction:column;align-items:center;gap:4px;padding:7px 0;border:0;background:transparent;color:#B8B2A8;font:11px sans-serif}.ds-nav-icon{display:grid;place-items:center;width:48px;height:28px;border-radius:16px;font-size:19px}.ds-current{color:#E5AA55}.ds-current .ds-nav-icon{background:#3B301E}.ds-nav-item:hover{background:#252525}.ds-nav-item:focus-visible{outline:2px solid #E5AA55;outline-offset:-2px}"
    },
    {
      "name": "手机调整工作区",
      "kind": "custom",
      "description": "Fit 完整预览占参数面板以外的空间；面板默认最多为可用高度 50%，内容可滚动并自然收缩。56dp 工具行提供收起或展开、可拖动比例和完成；比例默认 0.5，范围 0.3–0.72，预览最小为 min(192dp, 35% 可用高度)，面板最小为 min(240dp, 50% 可用高度)。拖动控制公开 progress 语义；底部主导航切模式并保留滚动及组展开状态。48dp 对比及全屏按钮叠加预览；全屏复用现有位图和画布，关闭后保留控件状态。没有新增解码、渲染或全尺寸缓存；这不是硬件性能基准。",
      "html": "<div class=\"ds-workspace\"><div class=\"ds-workspace-preview\">照片预览</div><div class=\"ds-workspace-panel\"><div class=\"ds-workspace-tools\"><button>收起参数</button><span class=\"ds-workspace-handle\"></span><button>完成</button></div><div class=\"ds-workspace-content\">胶片与相纸 · 参数</div></div></div>",
      "css": ".ds-workspace{display:flex;flex-direction:column;height:360px;background:#252525;color:#F2EEE6;font:12px sans-serif}.ds-workspace-preview{display:grid;place-items:center;flex:1;color:#B8B2A8}.ds-workspace-panel{background:#191919}.ds-workspace-tools{display:flex;align-items:center;height:56px;padding:0 8px}.ds-workspace-tools button{min-height:48px;border:0;background:transparent;color:#E5AA55}.ds-workspace-tools button:hover{background:#252525}.ds-workspace-tools button:focus-visible{outline:2px solid #E5AA55}.ds-workspace-handle{width:36px;height:4px;margin:auto;border-radius:2px;background:#888888}.ds-workspace-content{min-height:80px;padding:0 20px}"
    },
    {
      "name": "首页照片与会话",
      "kind": "custom",
      "description": "紧凑首页横向内边距 20dp，主照片宽高比 1.4；显示胶片、相纸、可用拍摄时间、来源格式、尺寸和拍摄参数。操作区并列提供主色填充的导入照片与52dp高的次级色调观景台按钮，观景台使用PhotoLibrary图标、12dp圆角并公开打开观景台标签。观景台支持空首页和已有会话进入，使用独立照片选择器，取消后留在观景台；返回箭头与系统Back返回Home。Home与编辑器入口共享根路由提升的FilmCanvasState；从Home观景台编辑照片会进入编辑器拍摄页。会话标题行包含数量和添加操作；112×84dp、10dp圆角的图像填充照片项在图内显示序号和格式。当前项使用1dp琥珀边框及编辑中标记，状态由队列选择决定。编辑器信息行共用拍摄参数格式化，显示来源格式；未知格式显示照片。",
      "html": "<section class=\"ds-home\"><div class=\"ds-home-title\"><strong>让光，慢慢显影。</strong><small>数字暗房 / 01</small></div><div class=\"ds-home-hero\"></div><div class=\"ds-home-meta\"><span>胶片 / 相纸</span><span>16:42</span></div><div class=\"ds-home-meta\"><span class=\"ds-home-accent\">JPG</span><span>6000 × 4000</span></div><div class=\"ds-home-meta\"><span>35 mm　f/2.8　1/500 s　ISO 200</span></div><div class=\"ds-home-session\"><strong>当前会话</strong><small>2 张照片</small><button>添加照片</button></div><div class=\"ds-home-strip\"><div class=\"ds-home-photo ds-home-current\"><span>01 · 编辑中</span><em>JPG</em></div><div class=\"ds-home-photo\"><span>02 · RAW</span></div></div></section>",
      "css": ".ds-home{max-width:393px;padding:12px 20px;background:#151515;color:#F2EEE6;font:12px sans-serif}.ds-home-title,.ds-home-meta,.ds-home-session{display:flex;align-items:center;justify-content:space-between;gap:12px}.ds-home-title{margin-bottom:14px;font-size:18px}.ds-home-title small,.ds-home-accent{color:#E5AA55}.ds-home-hero{width:100%;aspect-ratio:1.4;border-radius:16px;background:#2E2E2E}.ds-home-meta{margin-top:6px;color:#B8B2A8}.ds-home-session{margin-top:20px;border-top:1px solid #424242}.ds-home-session small{margin-left:auto;color:#B8B2A8}.ds-home-session button{min-height:48px;border:0;background:transparent;color:#E5AA55}.ds-home-session button:hover{background:#252525}.ds-home-session button:focus-visible{outline:2px solid #E5AA55}.ds-home-strip{display:flex;gap:10px;overflow:auto}.ds-home-photo{position:relative;flex:0 0 112px;height:84px;border-radius:10px;background:#2E2E2E}.ds-home-current{outline:1px solid #E5AA55;outline-offset:-1px}.ds-home-photo span,.ds-home-photo em{position:absolute;padding:3px 5px;border-radius:6px;background:rgba(0,0,0,.75);font-style:normal}.ds-home-photo span{bottom:6px;left:6px}.ds-home-current span{color:#E5AA55}.ds-home-photo em{top:6px;right:6px}"
    },
    {
      "name": "编辑照片工作台",
      "kind": "custom",
      "description": "顶部工具栏下常驻照片列表：64×60dp Fit 缩略图，72dp条高；短横屏56×48dp/56dp条高。点图直接切换，当前项自动滚入视野。左侧当前位置打开管理，右侧48dp添加按钮。底部管理保留信息、前后切换和移除，源文件不删除。顶部列表占布局空间不遮预览；拍摄/放印/调色共用，导出/观景台/裁剪/全屏使用专用布局。短横屏导航转到底部，侧栏最小窗口高500dp。",
      "html": "<section class=\"ds-edit-queue\"><button aria-label=\"管理照片工作台\">照片<br><strong>1/3</strong></button><div class=\"ds-edit-thumbs\"><button class=\"ds-active\" aria-pressed=\"true\"><span>1</span></button><button aria-pressed=\"false\"><span>2</span></button><button aria-pressed=\"false\"><span>3</span></button></div><button aria-label=\"添加编辑照片\">＋</button></section>",
      "css": ".ds-edit-queue{display:flex;align-items:center;min-height:72px;padding:6px 8px;box-sizing:border-box;background:#191919;color:#F2EEE6;gap:4px;font:12px sans-serif}.ds-edit-queue>button{flex:none;min-width:48px;min-height:48px;padding:0;border:0;border-radius:8px;background:transparent;color:#B8B2A8}.ds-edit-queue strong{color:#E5AA55;font-size:11px}.ds-edit-thumbs{flex:1;display:flex;gap:8px;overflow:auto;padding:0 4px}.ds-edit-thumbs button{position:relative;flex:none;width:64px;height:60px;border:0;border-radius:8px;background:#252525;color:#B8B2A8}.ds-edit-thumbs .ds-active{border:2px solid #E5AA55}.ds-edit-thumbs span{position:absolute;bottom:3px;left:3px;background:#1C1C1C;border-radius:6px;padding:0 4px}.ds-edit-queue button:focus-visible{outline:2px solid #E5AA55;outline-offset:-2px}"
    },
    {
      "name": "导出设置",
      "kind": "custom",
      "description": "最大宽度 600dp；照片信息区上、下内边距 12dp、8dp，单张/批量分段后间隔 12dp。高级设置使用低表面、12dp圆角的自适应行，最小高度56dp，水平内边距12dp、垂直内边距8dp，标题与摘要间距4dp、图标与文字间距12dp，并公开高级设置标签及展开状态；展开内容与三列快捷操作之间保留12dp间隔，折叠时仍保留该间隔。局部字号/行高为 9/12、10/14、11/16、12/16、14/20sp。DI TIFF、软打样、高清预览为实际动作；固定底部上下内边距4dp、间距6dp，按需显示的实际进度区内边距8dp、间距4dp，并提供取消。拍摄信息与位置信息为常驻独立开关，默认开/关，支持JPEG/PNG/TIFF、配方记忆与批量逐图复制；处理时禁用。",
      "html": "<div class=\"ds-export\"><div class=\"ds-export-row\">分辨率 <span>长边 2560 px</span></div><div class=\"ds-export-row\">色彩空间 <span>sRGB IEC61966-2.1</span></div><button class=\"ds-export-button\">导出当前照片</button></div>",
      "css": ".ds-export{max-width:600px;padding:0 20px;background:#151515;color:#F2EEE6;font:12px sans-serif}.ds-export-row{display:flex;align-items:center;justify-content:space-between;min-height:48px;border-bottom:1px solid #424242}.ds-export-row span{color:#B8B2A8;font-size:11px}.ds-export-button{width:100%;min-height:48px;margin-top:16px;border:0;border-radius:12px;background:#E5AA55;color:#261A0C;font-weight:600}.ds-export-button:hover{filter:brightness(1.08)}.ds-export-button:focus-visible{outline:2px solid #F2EEE6;outline-offset:2px}.ds-export-button:active{filter:brightness(.9)}"
    },
    {
      "name": "电影裁剪",
      "kind": "custom",
      "description": "2.39:1、1.85:1和自定义；框内连续移动，四角缩放，固定比例约束；28dp手势安全边距。",
      "html": "<section class=\"ds-edit-feature\">取消　裁剪照片　完成裁剪<br><div class=\"ds-crop-selection\"></div><span>比例　2.39:1　⌄</span></section>",
      "css": ".ds-edit-feature{padding:16px;background:#191919;color:#F2EEE6;font:14px sans-serif}.ds-edit-feature input{display:block;width:100%;accent-color:#E5AA55}.ds-crop-selection{aspect-ratio:2.39;margin:32px 12px;border:2px solid #F2EEE6;background:#252525}"
    },
    {
      "name": "暗角调节",
      "kind": "custom",
      "description": "调色中的强度、范围、羽化0–100；默认强度0，预览与JPEG/PNG/16-bit TIFF输出共用空间坐标算法。",
      "html": "<section class=\"ds-edit-feature\">暗角<br>强度　75%<input type=\"range\" value=\"75\"><br>范围　50%<input type=\"range\" value=\"50\"><br>羽化　70%<input type=\"range\" value=\"70\"></section>",
      "css": ".ds-edit-feature{padding:16px;background:#191919;color:#F2EEE6;font:14px sans-serif}.ds-edit-feature input{display:block;width:100%;accent-color:#E5AA55}.ds-crop-selection{aspect-ratio:2.39;margin:32px 12px;border:2px solid #F2EEE6;background:#252525}"
    },
    {
      "name": "智能显影",
      "kind": "custom",
      "description": "首页导入上方和编辑器顶部48dp星芒入口。自然耐看、电影浓郁、轻柔复古三选并记忆；可关闭导入自动处理，已有编辑优先。局部统计逐图选片/相纸/调色，不是语义AI或客观最佳保证。显式应用可撤销并保留几何。",
      "html": "<section class=\"ds-smart\"><header><strong>智能显影</strong></header><label><input type=\"radio\" name=\"smart\">自然耐看<small>保留现场色彩，柔和修整明暗</small></label><label class=\"ds-smart-selected\"><input type=\"radio\" name=\"smart\" checked>电影浓郁<small>更有层次的反差与电影胶片色彩</small></label><label><input type=\"radio\" name=\"smart\">轻柔复古<small>温润色彩、柔和影调与适量颗粒</small></label><footer>导入后自动显影　<input type=\"checkbox\" checked></footer></section>",
      "css": ".ds-smart{max-width:420px;background:#191919;color:#F2EEE6;padding:20px;font:14px sans-serif;border-radius:20px 20px 0 0}.ds-smart header{display:flex;align-items:center;min-height:48px}.ds-smart label{display:block;min-height:48px;margin-top:6px;padding:12px;border-radius:12px}.ds-smart small{display:block;margin:6px 0 0 24px;color:#B8B2A8}.ds-smart-selected{background:#2E2E2E}.ds-smart input{accent-color:#E5AA55}.ds-smart footer{min-height:56px;display:flex;align-items:center;justify-content:space-between}"
    }
  ],
  "narrative": {
    "northStar": "数字暗房",
    "overview": "以 Darkroom、Lightroom 与胶片美学为方向：深炭灰工作环境、暖纸色文字和克制的琥珀强调色让照片成为视觉主体。界面专业、安静，服务反复调整和比较。\n\n基于 Kotlin、Jetpack Compose 与 Material 3。此文记录已实现的 Android UI；dp 和 sp 是源代码单位，随设备密度和字体缩放解释。",
    "keyCharacteristics": [
      "照片优先，控制区紧凑而可触达。",
      "色阶区分工作区域，琥珀标记选择和关键操作。",
      "手机与宽屏使用适合可用空间的导航和参数布局。"
    ],
    "rules": [],
    "dos": [
      "Do 让照片预览保持主要视觉权重。",
      "Do 使用表面色阶和琥珀选中状态表达层级。",
      "Do 保持控件的触控尺寸与语义，支持系统字体缩放。"
    ],
    "donts": [
      "Don't 用大面积强调色压过照片和参数。",
      "Don't 将参数、选中状态或导航语义仅交给颜色传达。"
    ]
  }
}
